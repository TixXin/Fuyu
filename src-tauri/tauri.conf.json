{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fuyu",
  "version": "0.3.9-beta.1",
  "identifier": "com.tixxin.fuyu",
  "build": {
    "beforeDevCommand": "node scripts/stop-running-island.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Fuyu",
        "width": 820,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "translation",
        "title": "浮屿 翻译",
        "url": "index.html?window=translation",
        "width": 480,
        "height": 640,
        "minWidth": 480,
        "minHeight": 380,
        "acceptFirstMouse": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "clipboard",
        "title": "浮屿 - 剪贴板",
        "url": "index.html?window=clipboard",
        "width": 380,
        "height": 559,
        "acceptFirstMouse": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "clipboard-preview",
        "title": "浮屿 - 剪贴板预览",
        "url": "index.html?window=clipboard-preview",
        "width": 420,
        "height": 559,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "settings",
        "create": false,
        "title": "Fuyu",
        "url": "index.html?window=settings",
        "width": 1080,
        "height": 860,
        "minWidth": 580,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#131417"
      },
      {
        "label": "onboarding",
        "create": false,
        "title": "Fuyu",
        "url": "index.html?window=onboarding",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NjAzNzhCNUVGQTEzNTIKUldSU0UvcGVpemRnZE4wS3NHdzQ1eGFPY0lBNjRnNDAvUnFmNG82b3Zld2o3TFlqdFpLRnpRUzMK",
      "endpoints": [
        "https://github.com/TixXin/fuyu/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/TixXin/fuyu/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/TixXin/fuyu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "homepage": "https://fuyu.ing",
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
