diff --git a/dist/lib/lane-owner.js b/dist/lib/lane-owner.js
new file mode 100644
index 0000000000000000000000000000000000000000..0073d781e559f8732a83018c07f3e7ec3433555e
--- /dev/null
+++ b/dist/lib/lane-owner.js
@@ -0,0 +1,87 @@
+// fly-island patch: Windows has no lsof, so the stock "is a session still in
+// this lane?" check always said yes and no lane was ever pruned. Instead the
+// WorktreeCreate hook records the claude.exe that asked for the lane, and a
+// lane counts as in use while that process is alive.
+import { execFileSync } from "node:child_process";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { repoKey } from "./queue-lock.js";
+
+function ownersFile() {
+    return join(repoKey(), "claude-code-merge-queue", "lane-owners.json");
+}
+function key(path) {
+    return resolve(path).toLowerCase();
+}
+export function readLaneOwners() {
+    return readOwners();
+}
+function readOwners() {
+    try {
+        return JSON.parse(readFileSync(ownersFile(), "utf8"));
+    }
+    catch {
+        return {};
+    }
+}
+function writeOwners(owners) {
+    const file = ownersFile();
+    mkdirSync(dirname(file), { recursive: true });
+    writeFileSync(file, JSON.stringify(owners, null, 2) + "\n");
+}
+/** The nearest claude.exe above this process, or null. */
+export function findClaudeAncestorPid() {
+    if (process.platform !== "win32")
+        return null;
+    let rows;
+    try {
+        const out = execFileSync("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command",
+            "Get-CimInstance Win32_Process | Select-Object ProcessId,ParentProcessId,Name | ConvertTo-Json -Compress"], { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, stdio: ["ignore", "pipe", "ignore"] });
+        rows = JSON.parse(out);
+    }
+    catch {
+        return null;
+    }
+    const byPid = new Map(rows.map((row) => [row.ProcessId, row]));
+    let row = byPid.get(process.pid);
+    for (let hops = 0; row && hops < 32; hops += 1) {
+        if (/^claude(\.exe)?$/i.test(row.Name ?? ""))
+            return row.ProcessId;
+        row = byPid.get(row.ParentProcessId);
+    }
+    return null;
+}
+export function recordLaneOwner(wt, pid) {
+    if (!pid)
+        return;
+    const owners = readOwners();
+    owners[key(wt)] = { pid, since: new Date().toISOString() };
+    writeOwners(owners);
+}
+export function forgetLaneOwner(wt) {
+    const owners = readOwners();
+    if (owners[key(wt)]) {
+        delete owners[key(wt)];
+        writeOwners(owners);
+    }
+}
+export function pidAlive(pid) {
+    return alive(pid);
+}
+function alive(pid) {
+    try {
+        process.kill(pid, 0);
+        return true;
+    }
+    catch (e) {
+        return e.code === "EPERM";
+    }
+}
+/** true while the recorded owner runs; a lane with no record is treated as in use. */
+export function laneOwnerAlive(wt) {
+    const owner = readOwners()[key(wt)];
+    return owner ? alive(owner.pid) : true;
+}
+export function hasLaneOwner(wt) {
+    return Boolean(readOwners()[key(wt)]);
+}
diff --git a/dist/lib/lane-pool.js b/dist/lib/lane-pool.js
new file mode 100644
index 0000000000000000000000000000000000000000..913790afd6f50168ea22044d89d7dca65f43f144
--- /dev/null
+++ b/dist/lib/lane-pool.js
@@ -0,0 +1,141 @@
+// fly-island patch: a pool of lanes instead of a new one per session. The stock
+// hook only takes a lane number whose folder does not exist, so every /clear,
+// restart or new session added a lane and they piled up (27 on one machine).
+// Before creating one, the WorktreeCreate hook now takes back an idle lane:
+//   1. the lane the session is already in (a /clear asks for a worktree again);
+//   2. a lane the same claude.exe asked for earlier;
+//   (3. the lowest-numbered lane nobody uses: off until lanes record who uses them.)
+// A lane is reused only when it has no uncommitted or untracked files and
+// nothing that is not already in the main checkout's HEAD, so no work is lost.
+// "Nobody uses it": its recorded owner is not another live claude.exe, and its
+// folder can be renamed, which Windows refuses while any process has its
+// current directory in there (a session, a dev server, a shell).
+// A reused lane is reset to the main checkout's HEAD and keeps its
+// node_modules and untracked build caches.
+import { execFileSync } from "node:child_process";
+import { existsSync, mkdirSync, renameSync, rmSync, statSync } from "node:fs";
+import { basename, dirname, join, resolve, sep } from "node:path";
+import { readLaneOwners } from "./lane-owner.js";
+
+const MAX_LANE = 200;
+const LOCK_STALE_MS = 60 * 1000;
+
+function git(args, cwd) {
+    return execFileSync("git", args, { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
+}
+function tryGit(args, cwd) {
+    try {
+        return { ok: true, out: git(args, cwd) };
+    }
+    catch {
+        return { ok: false, out: "" };
+    }
+}
+function key(path) {
+    return resolve(path).toLowerCase();
+}
+export function lanePath(mainTop, cfg, lane) {
+    return join(dirname(mainTop), `${basename(mainTop)}${cfg.worktreeSuffix}${lane}`);
+}
+/** The lane number of `dir` (or a folder inside it), or null. */
+export function laneOf(mainTop, cfg, dir) {
+    const target = key(dir);
+    for (let lane = 1; lane <= MAX_LANE; lane += 1) {
+        const wt = key(lanePath(mainTop, cfg, lane));
+        if (target === wt || target.startsWith(wt + sep))
+            return lane;
+    }
+    return null;
+}
+/** Why `wt` cannot be reused, or null when it has nothing to lose. */
+export function workIn(wt, mainHead) {
+    if (!existsSync(join(wt, ".git")))
+        return "not a worktree";
+    const status = tryGit(["status", "--porcelain", "--untracked-files=all"], wt);
+    if (!status.ok)
+        return "git status failed";
+    if (status.out)
+        return "uncommitted files";
+    if (!tryGit(["merge-base", "--is-ancestor", "HEAD", mainHead], wt).ok)
+        return "commits not on main";
+    return null;
+}
+/** Whether a process has its current directory in `wt`: Windows then refuses to rename it. */
+export function folderBusy(wt) {
+    if (process.platform !== "win32")
+        return false;
+    const probe = `${wt}.probe-${process.pid}`;
+    try {
+        renameSync(wt, probe);
+    }
+    catch {
+        return true;
+    }
+    renameSync(probe, wt);
+    return false;
+}
+function withPoolLock(mainTop, work) {
+    const common = resolve(mainTop, git(["rev-parse", "--git-common-dir"], mainTop));
+    const lock = join(common, "claude-code-merge-queue", "lane-pool.lock");
+    mkdirSync(dirname(lock), { recursive: true });
+    for (let tries = 0;; tries += 1) {
+        try {
+            mkdirSync(lock);
+            break;
+        }
+        catch {
+            let age = 0;
+            try {
+                age = Date.now() - statSync(lock).mtimeMs;
+            }
+            catch {
+                continue;
+            }
+            if (age > LOCK_STALE_MS || tries > 100) {
+                rmSync(lock, { recursive: true, force: true });
+                continue;
+            }
+            Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 100);
+        }
+    }
+    try {
+        return work();
+    }
+    finally {
+        rmSync(lock, { recursive: true, force: true });
+    }
+}
+/**
+ * Picks an idle lane for a session started from `fromCwd` by claude.exe `claudePid` (or null),
+ * resets it to the main checkout's HEAD and returns `{ wt, branch, lane }`; null when none is idle.
+ */
+export function reuseIdleLane(mainTop, cfg, fromCwd, claudePid) {
+    return withPoolLock(mainTop, () => {
+        const mainHead = git(["rev-parse", "HEAD"], mainTop);
+        const owners = readLaneOwners();
+        const existing = [];
+        for (let lane = 1; lane <= MAX_LANE; lane += 1) {
+            if (existsSync(lanePath(mainTop, cfg, lane)))
+                existing.push(lane);
+        }
+        const current = fromCwd ? laneOf(mainTop, cfg, fromCwd) : null;
+        const ownedBy = (lane) => owners[key(lanePath(mainTop, cfg, lane))]?.pid ?? null;
+        // Only the session's own lane for now. Most sessions work in a lane from the main
+        // checkout by absolute paths, or take one over from another session, and nothing
+        // records that yet, so a lane that looks idle may well be someone's (F23 follow-up).
+        const order = [
+            ...existing.filter((lane) => lane === current),
+            ...existing.filter((lane) => lane !== current && claudePid && ownedBy(lane) === claudePid),
+        ];
+        for (const lane of order) {
+            const wt = lanePath(mainTop, cfg, lane);
+            if (workIn(wt, mainHead))
+                continue;
+            const branch = `${cfg.branchPrefix}${lane}`;
+            if (!tryGit(["checkout", "-q", "-B", branch, mainHead], wt).ok)
+                continue;
+            return { wt, branch, lane, reused: true };
+        }
+        return null;
+    });
+}
