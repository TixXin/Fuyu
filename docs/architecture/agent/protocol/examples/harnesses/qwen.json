{
  "$schema": "../../harness.schema.json",
  "protocol": 1,
  "id": "qwen",
  "name": "Qwen Code",
  "icon": "qwen.svg",
  "forms": {
    "cli": {
      "home": [{ "path": "~/.qwen", "env": "QWEN_HOME" }],
      "linux": { "runs": true }
    }
  },
  "sessions": { "format": "qwen-jsonl", "dirs": ["projects"], "chats": "chats" },
  "hooks": {
    "format": "claude-compatible",
    "file": "settings.json",
    "events": {
      "start": "UserPromptSubmit",
      "activity": ["PostToolUse", "PostToolUseFailure", "PermissionDenied", "Stop", "SubagentStop", "UserPromptSubmit"],
      "stop": "Stop",
      "waiting": "PermissionRequest",
      "approval": "PermissionRequest"
    },
    "waitingKind": "permissionRequest"
  },
  "approval": { "reply": "permissionRequest" },
  "signals": { "running": "hook", "done": "hook", "waiting": "hook", "replyMarker": true, "exited": "hook" },
  "replyMarker": { "promptFiles": ["QWEN.md"] },
  "ccConnect": null
}
