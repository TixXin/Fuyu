{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TixXin/fuyu/blob/main/docs/architecture/agent/protocol/harness.schema.json",
  "title": "Fuyu agent harness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "name",
    "forms",
    "sessions",
    "signals"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "protocol": {
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "name": {
      "$ref": "#/definitions/text"
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.(svg|png)$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/id"
      },
      "uniqueItems": true
    },
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cli": {
          "$ref": "#/definitions/form"
        },
        "app": {
          "$ref": "#/definitions/form"
        },
        "ideExtension": {
          "$ref": "#/definitions/form"
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "claude-jsonl",
            "codebuddy-jsonl",
            "qwen-jsonl",
            "pi-jsonl",
            "adapter"
          ]
        },
        "adapter": {
          "$ref": "#/definitions/adapter"
        },
        "dirs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relativePath"
          },
          "minItems": 1
        },
        "chats": {
          "$ref": "#/definitions/relativePath"
        },
        "subagents": {
          "enum": [
            "hide",
            "nest"
          ],
          "default": "hide"
        }
      },
      "if": {
        "properties": {
          "format": {
            "const": "adapter"
          }
        }
      },
      "then": {
        "required": [
          "adapter"
        ]
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "claude-compatible",
            "codex",
            "adapter"
          ]
        },
        "adapter": {
          "$ref": "#/definitions/adapter"
        },
        "file": {
          "$ref": "#/definitions/relativePath"
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/definitions/eventName"
            },
            "activity": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            },
            "stop": {
              "$ref": "#/definitions/eventName"
            },
            "failed": {
              "$ref": "#/definitions/eventName"
            },
            "waiting": {
              "$ref": "#/definitions/eventName"
            },
            "approval": {
              "$ref": "#/definitions/eventName"
            }
          }
        },
        "waitingKind": {
          "enum": [
            "permissionRequest",
            "permissionPrompt"
          ]
        },
        "inputAliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Field in this harness's hook input -> field name Claude Code uses"
        },
        "restartRequired": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "adapter"
              }
            }
          },
          "then": {
            "required": [
              "adapter"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "claude-compatible"
              }
            }
          },
          "then": {
            "required": [
              "file",
              "events",
              "waitingKind"
            ]
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reply"
      ],
      "properties": {
        "reply": {
          "enum": [
            "permissionRequest",
            "preToolUse",
            "behavior",
            "adapter",
            "none"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "questions": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "running",
        "done",
        "waiting",
        "replyMarker",
        "exited"
      ],
      "properties": {
        "running": {
          "enum": [
            "hook",
            "session",
            "adapter",
            null
          ]
        },
        "done": {
          "enum": [
            "hook",
            "session",
            "adapter",
            null
          ]
        },
        "waiting": {
          "enum": [
            "hook",
            "approval",
            "adapter",
            null
          ]
        },
        "replyMarker": {
          "type": "boolean"
        },
        "exited": {
          "enum": [
            "hook",
            "process",
            "adapter",
            "timeout"
          ]
        }
      }
    },
    "replyMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptFiles"
      ],
      "properties": {
        "promptFiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relativePath"
          },
          "minItems": 1
        }
      }
    },
    "quota": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/id"
      },
      "uniqueItems": true
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "pull"
      ],
      "properties": {
        "form": {
          "const": "cli"
        },
        "pull": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "find": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sessionDirs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/remoteDir"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/relativePath"
              }
            },
            "checkpointDirs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/remoteDir"
              }
            }
          }
        },
        "extract": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/adapter"
            }
          ]
        },
        "hooks": {
          "type": "boolean",
          "default": false
        },
        "approval": {
          "enum": [
            "reverseForward",
            null
          ]
        },
        "replyMarker": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cli": {
              "$ref": "#/definitions/hostIds"
            },
            "app": {
              "$ref": "#/definitions/hostIds"
            },
            "ideExtension": {
              "$ref": "#/definitions/hostIds"
            }
          }
        },
        "adapter": {
          "$ref": "#/definitions/adapter"
        },
        "exact": {
          "enum": [
            "tab",
            "window"
          ]
        }
      }
    },
    "ccConnect": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      ]
    },
    "push": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "takeover": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "signals": {
            "properties": {
              "replyMarker": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "replyMarker"
        ]
      }
    },
    {
      "if": {
        "required": [
          "remote"
        ]
      },
      "then": {
        "properties": {
          "forms": {
            "required": [
              "cli"
            ],
            "properties": {
              "cli": {
                "required": [
                  "linux"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,31}$"
    },
    "adapter": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "eventName": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![/~])(?!.*\\.\\.)[^\\\\:]+$"
    },
    "remoteDir": {
      "type": "string",
      "pattern": "^(?![/~])(?!.*\\.\\.)[^\\\\:]+/$"
    },
    "hostIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9 ._-]*$"
      },
      "minItems": 1
    },
    "text": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-CN",
            "en"
          ],
          "properties": {
            "zh-CN": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(~/|%APPDATA%/|%LOCALAPPDATA%/|<AppData>/)"
              },
              "env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "env"
                ]
              }
            ]
          }
        },
        "sharesWith": {
          "enum": [
            "cli",
            "app",
            "ideExtension"
          ]
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "windows": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "macos": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "linux": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "linux": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runs"
          ],
          "properties": {
            "runs": {
              "type": "boolean"
            },
            "glibc": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+$"
            },
            "musl": {
              "type": "boolean"
            }
          }
        }
      },
      "not": {
        "required": [
          "home",
          "sharesWith"
        ]
      }
    }
  }
}
