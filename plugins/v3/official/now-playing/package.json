{
  "name": "@fuyu/now-playing",
  "version": "1.0.0",
  "type": "module",
  "description": "Shows the playing song's title and artist on the island manually or when tracks change.",
  "license": "MIT",
  "author": "TixXin",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev --official",
    "build": "fuyu-plugin build --official",
    "check": "fuyu-plugin check --official --market",
    "package": "fuyu-plugin pack --official",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "正在播放",
      "en": "Now playing"
    },
    "description": {
      "zh-CN": "在设置中点击「立即显示正在播放」或开启「换歌时自动提示」，在岛上显示当前歌曲名与歌手。",
      "en": "Shows the current song title and artist on the island on demand or automatically when tracks change."
    },
    "icon": "assets/icon.svg",
    "categories": [
      "media"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "client": {
      "settings": "dist/settings.js"
    },
    "inject": {
      "required": [
        "media/v1",
        "messages/v1"
      ]
    },
    "slots": [
      "settings.section/v1"
    ],
    "commands": [
      {
        "id": "show",
        "title": {
          "zh-CN": "立即显示正在播放",
          "en": "Show now playing"
        }
      }
    ]
  }
}
