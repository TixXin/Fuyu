{
  "name": "@fuyu/now-playing",
  "version": "1.3.0",
  "type": "module",
  "description": "Shows the song title and artist on the island when the track changes.",
  "keywords": [
    "换歌",
    "切歌",
    "歌名",
    "歌曲",
    "音乐",
    "正在播放",
    "now playing",
    "music",
    "song",
    "track",
    "media"
  ],
  "license": "MIT",
  "author": "TixXin",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev --official",
    "build": "fuyu-plugin build --official",
    "check": "fuyu-plugin check --official --market",
    "package": "fuyu-plugin pack --official",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "换歌提示",
      "en": "Track change notice"
    },
    "description": {
      "zh-CN": "换歌时在岛上弹一下歌名和歌手，不用切过去看。",
      "en": "Shows the song title and artist on the island when the track changes."
    },
    "icon": "assets/icon.svg",
    "screenshots": [
      {
        "path": "screenshots/card.png",
        "caption": {
          "zh-CN": "换歌时岛上弹出的提示：封面、歌名、歌手和播放软件，带上一首、暂停、下一首",
          "en": "The notice on the island when the track changes: cover, title, artist and player, with previous, pause and next"
        }
      }
    ],
    "categories": [
      "media"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "client": {
      "settings": "dist/settings.js"
    },
    "inject": {
      "required": [
        "commands",
        "media/v1",
        "messages/v1"
      ]
    },
    "slots": [
      "settings.section/v1"
    ],
    "commands": [
      {
        "id": "show",
        "title": {
          "zh-CN": "立即提示当前歌曲",
          "en": "Show the current song"
        }
      }
    ]
  }
}
