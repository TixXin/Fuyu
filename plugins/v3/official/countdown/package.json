{
  "name": "@fuyu/countdown",
  "version": "1.1.0",
  "type": "module",
  "description": "Keeps track of birthdays, anniversaries and deadlines year after year, with the days left on the collapsed bar.",
  "author": "TixXin",
  "license": "MIT",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev",
    "build": "fuyu-plugin build",
    "check": "fuyu-plugin check --market",
    "package": "fuyu-plugin pack",
    "typecheck": "tsc"
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "倒数日",
      "en": "Day counter"
    },
    "description": {
      "zh-CN": "记着生日、纪念日和截止日，每年自动续上，收起条上一眼看到还剩几天。",
      "en": "Keeps track of birthdays, anniversaries and deadlines year after year, with the days left on the collapsed bar."
    },
    "icon": "assets/icon.svg",
    "categories": [
      "productivity",
      "utilities"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "client": {
      "island": "dist/island.js",
      "settings": "dist/settings.js"
    },
    "inject": {
      "optional": [
        "messages/v1"
      ]
    },
    "slots": [
      "island.page/v1",
      "island.collapsed/v1",
      "settings.section/v1"
    ]
  }
}
