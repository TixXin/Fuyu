{
  "name": "@fuyu/launcher",
  "version": "1.1.0",
  "type": "module",
  "description": "Type a few letters on the island to open any app on your computer; the ones you use most come first.",
  "license": "MIT",
  "author": "TixXin",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev --official",
    "build": "fuyu-plugin build --official",
    "check": "fuyu-plugin check --official --market",
    "package": "fuyu-plugin pack --official",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "应用启动台",
      "en": "App launcher"
    },
    "description": {
      "zh-CN": "在岛上输入几个字母就能打开电脑上的应用，常用的排在前面。",
      "en": "Type a few letters on the island to open any app on your computer; the ones you use most come first."
    },
    "icon": "assets/icon.svg",
    "screenshots": [
      {
        "path": "screenshots/recent.png",
        "caption": {
          "zh-CN": "最近用过的应用排在最前，回车就能打开",
          "en": "Recently used apps come first; press Enter to open"
        }
      }
    ],
    "categories": [
      "productivity",
      "utilities"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "client": {
      "island": "dist/island.js",
      "settings": "dist/settings.js"
    },
    "slots": [
      "island.page/v1",
      "settings.section/v1"
    ],
    "commands": [
      {
        "id": "open",
        "title": {
          "zh-CN": "打开应用启动台",
          "en": "Open App launcher"
        }
      },
      {
        "id": "rescan",
        "title": {
          "zh-CN": "重新扫描应用",
          "en": "Rescan apps"
        }
      }
    ]
  }
}
