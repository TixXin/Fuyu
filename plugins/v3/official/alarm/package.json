{
  "name": "@fuyu/alarm",
  "version": "1.1.0",
  "type": "module",
  "description": "Set one-time or weekly alarms that remind you on the island and ring, with snooze and adjustable volume and ring length.",
  "author": "TixXin",
  "license": "MIT",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev",
    "build": "fuyu-plugin build",
    "check": "fuyu-plugin check --market",
    "package": "fuyu-plugin pack",
    "typecheck": "tsc"
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "闹钟",
      "en": "Alarm"
    },
    "description": {
      "zh-CN": "设置单次或按星期重复的闹钟，到点在岛上提醒并响铃，可以贪睡、调音量和响铃时长。",
      "en": "Set one-time or weekly alarms that remind you on the island and ring, with snooze and adjustable volume and ring length."
    },
    "icon": "assets/icon.svg",
    "categories": [
      "productivity",
      "utilities"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "client": {
      "island": "dist/island.js",
      "settings": "dist/settings.js"
    },
    "inject": {
      "required": [
        "commands",
        "messages/v1"
      ],
      "optional": [
        "reminders/v1"
      ]
    },
    "slots": [
      "island.page/v1",
      "island.collapsed/v1",
      "island.runner/v1",
      "settings.section/v1"
    ],
    "commands": [
      {
        "id": "dismiss",
        "title": {
          "zh-CN": "停止闹钟响铃",
          "en": "Dismiss ringing alarm"
        }
      },
      {
        "id": "snooze",
        "title": {
          "zh-CN": "闹钟贪睡",
          "en": "Snooze ringing alarm"
        }
      }
    ]
  }
}
