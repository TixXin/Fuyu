{
  "name": "@fuyu/alarm",
  "version": "1.0.0",
  "type": "module",
  "description": "Alarms with weekday schedules, Web Audio chimes, snooze, and island notifications",
  "author": "TixXin",
  "license": "MIT",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev",
    "build": "fuyu-plugin build",
    "check": "fuyu-plugin check --market",
    "package": "fuyu-plugin pack",
    "typecheck": "tsc"
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "闹钟",
      "en": "Alarm"
    },
    "description": {
      "zh-CN": "设置多组定时与按周重复闹钟，到点在岛上弹出提醒并播放可选铃声，支持贪睡与收起条预览。",
      "en": "Set one-time or recurring weekday alarms that notify on the island and play selectable chimes, with snooze and collapsed-bar preview."
    },
    "icon": "assets/icon.svg",
    "categories": [
      "productivity",
      "utilities"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "client": {
      "island": "dist/island.js",
      "settings": "dist/settings.js"
    },
    "inject": {
      "required": [
        "messages/v1"
      ],
      "optional": [
        "reminders/v1"
      ]
    },
    "slots": [
      "island.page/v1",
      "island.collapsed/v1",
      "island.runner/v1",
      "settings.section/v1"
    ],
    "commands": [
      {
        "id": "dismiss",
        "title": {
          "zh-CN": "停止闹钟响铃",
          "en": "Dismiss ringing alarm"
        }
      }
    ]
  }
}
