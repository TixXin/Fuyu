{
  "name": "@fuyu/pomodoro",
  "version": "1.1.0",
  "type": "module",
  "description": "Focus in rounds with breaks in between, optionally on one of today's todos, and keep count of today's rounds.",
  "author": "TixXin",
  "license": "MIT",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev",
    "build": "fuyu-plugin build",
    "check": "fuyu-plugin check --market",
    "package": "fuyu-plugin pack",
    "typecheck": "tsc"
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "番茄钟",
      "en": "Pomodoro"
    },
    "description": {
      "zh-CN": "按轮专注、轮间休息，可以挑一条今天的待办来做，到点在岛上提醒，并记下今天完成了几轮。",
      "en": "Focus in rounds with breaks in between, optionally on one of today's todos, and keep count of today's rounds."
    },
    "icon": "assets/icon.svg",
    "categories": [
      "productivity",
      "todos"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "client": {
      "island": "dist/island.js",
      "settings": "dist/settings.js"
    },
    "inject": {
      "required": [
        "commands",
        "timers/v1",
        "todos/v1",
        "messages/v1"
      ]
    },
    "slots": [
      "island.page/v1",
      "island.collapsed/v1",
      "settings.section/v1"
    ],
    "commands": [
      {
        "id": "start",
        "title": {
          "zh-CN": "开始番茄钟",
          "en": "Start pomodoro"
        },
        "keybinding": "Ctrl+Alt+P"
      },
      {
        "id": "stop",
        "title": {
          "zh-CN": "停止番茄钟",
          "en": "Stop pomodoro"
        }
      },
      {
        "id": "pause",
        "title": {
          "zh-CN": "暂停 / 继续番茄钟",
          "en": "Pause or resume pomodoro"
        }
      }
    ]
  }
}
