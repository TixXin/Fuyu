{
  "name": "@fuyu/weather",
  "version": "1.1.0",
  "type": "module",
  "description": "Current weather and the next few days' forecast on the island, with a heads-up before it rains.",
  "license": "MIT",
  "author": "TixXin",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev --official",
    "build": "fuyu-plugin build --official",
    "check": "fuyu-plugin check --official --market",
    "package": "fuyu-plugin pack --official",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "天气",
      "en": "Weather"
    },
    "description": {
      "zh-CN": "在岛上看现在的天气和未来几天的预报，快下雨时提醒你带伞。",
      "en": "Current weather and the next few days' forecast on the island, with a heads-up before it rains."
    },
    "icon": "assets/icon.svg",
    "screenshots": [
      {
        "path": "screenshots/page.png",
        "caption": {
          "zh-CN": "岛上页面：现在、逐小时和 7 天",
          "en": "Island page: now, hourly and 7 days"
        }
      }
    ],
    "categories": [
      "information"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "client": {
      "island": "dist/island.js",
      "settings": "dist/settings.js"
    },
    "inject": {
      "required": [
        "commands",
        "messages/v1"
      ]
    },
    "slots": [
      "island.page/v1",
      "island.collapsed/v1",
      "settings.section/v1"
    ],
    "commands": [
      {
        "id": "refresh",
        "title": {
          "zh-CN": "立即刷新天气",
          "en": "Refresh weather now"
        }
      }
    ],
    "network": [
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com"
    ]
  }
}
