{
  "name": "@fuyu/ecdict",
  "version": "1.0.0",
  "type": "module",
  "description": "Zero-configuration offline English-Chinese dictionary engine powered by ECDICT, requiring no API key or network access.",
  "license": "MIT",
  "author": "TixXin",
  "repository": "https://github.com/TixXin/fuyu",
  "keywords": [
    "dictionary",
    "translation",
    "offline",
    "ecdict"
  ],
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev --official",
    "build": "fuyu-plugin build --official",
    "check": "fuyu-plugin check --official --market",
    "package": "fuyu-plugin pack --official",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "ECDICT 离线词典",
      "en": "ECDICT Offline Dictionary"
    },
    "description": {
      "zh-CN": "基于开源 ECDICT 的零配置离线英汉词典引擎，免 API Key 支持英查中、词形还原与简明中查英。",
      "en": "Zero-configuration offline English-Chinese dictionary engine powered by ECDICT, with word lemmatization and reverse Chinese lookup."
    },
    "icon": "assets/icon.svg",
    "categories": [
      "productivity",
      "utilities"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "inject": {
      "required": [
        "translator.engines"
      ]
    }
  }
}
