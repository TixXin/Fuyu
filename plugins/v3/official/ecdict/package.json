{
  "name": "@fuyu/ecdict",
  "version": "1.0.1",
  "type": "module",
  "description": "Look up English words in Quick translate even when you're offline, or find the English for a Chinese word.",
  "keywords": [
    "词典",
    "字典",
    "查词",
    "单词",
    "英汉",
    "离线",
    "翻译",
    "dictionary",
    "translation",
    "offline",
    "word lookup",
    "ecdict"
  ],
  "license": "MIT",
  "author": "TixXin",
  "repository": "https://github.com/TixXin/fuyu",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev --official",
    "build": "fuyu-plugin build --official",
    "check": "fuyu-plugin check --official --market",
    "package": "fuyu-plugin pack --official",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "离线词典",
      "en": "Offline dictionary"
    },
    "description": {
      "zh-CN": "在快捷翻译里查英文单词，不联网也能查，也能用中文反查英文。",
      "en": "Look up English words in Quick translate even when you're offline, or find the English for a Chinese word."
    },
    "icon": "assets/icon.svg",
    "categories": [
      "utilities",
      "productivity"
    ],
    "platforms": [
      "windows",
      "macos"
    ],
    "host": "dist/host.js",
    "inject": {
      "required": [
        "translator.engines"
      ]
    }
  }
}
