{
  "format": 1,
  "plugins": [
    { "id": "todos", "kind": "builtin", "root": "todos", "host": "host/index.mjs", "background": ["shortcuts"], "provides": ["todos/v1"] },
    { "id": "calendar", "kind": "builtin", "root": "calendar", "host": "host/index.mjs", "background": ["shortcuts"], "provides": ["calendar/v1"] },
    { "id": "music", "kind": "builtin", "root": "media", "host": "host/index.mjs", "background": ["session"], "provides": ["media/v1", "lyrics/v1"] },
    { "id": "clipboard", "kind": "builtin", "root": "clipboard", "host": "host/index.mjs", "background": ["listener", "windows"], "provides": ["clipboard/v1"] },
    { "id": "screenshot", "kind": "builtin", "root": "screenshot", "host": "host/index.mjs", "background": ["shortcuts", "windows"] },
    { "id": "file-shelf", "kind": "builtin", "root": "file-shelf", "host": "host/index.mjs", "background": [], "provides": ["file-shelf/v1"] },
    { "id": "translation", "kind": "builtin", "root": "translation", "host": "host/index.mjs", "background": ["shortcuts", "window"], "provides": ["translator/v1"] },
    { "id": "voice-input", "kind": "builtin", "root": "voice-input", "host": "host/index.mjs", "background": ["shortcuts"] },
    { "id": "timer", "kind": "builtin", "root": "timer", "host": "host/index.mjs", "background": ["shortcuts"], "provides": ["timers/v1", "reminders/v1"] },
    { "id": "agents", "kind": "builtin", "root": "agent-status", "host": "host/index.mjs", "background": ["approvals", "opencode", "remote", "hotkeys"], "provides": ["agents/v1"] },
    { "id": "session-ring", "kind": "builtin", "defaultOff": true, "root": "session-ring", "host": "host/index.mjs", "background": [] },
    { "id": "claude-usage", "kind": "builtin", "defaultOff": true, "root": "claude-usage", "host": "host/index.mjs", "background": ["poller"] },
    { "id": "cc-connect", "kind": "builtin", "defaultOff": true, "root": "cc-connect", "host": "host/index.mjs", "background": ["runner"], "provides": ["cc-connect/v1"] },
    { "id": "ssh-tunnel", "kind": "builtin", "defaultOff": true, "root": "ssh-tunnel", "host": "host/index.mjs", "background": ["tunnels"] },
    { "id": "local-api", "kind": "builtin", "defaultOff": true, "root": "local-api", "host": "host/index.mjs", "background": ["server"] },
    { "id": "center-pattern", "kind": "builtin", "defaultOff": true, "root": "center-pattern", "host": "host/index.mjs", "background": [] },
    { "id": "messages", "kind": "builtin", "root": "messages", "host": "host/index.mjs", "background": ["qq", "wechat", "mail", "telegram", "discord", "whatsapp", "tim", "feishu", "dingtalk", "wecom"], "provides": ["messages/v1", "island-notices/v1"] },
    { "id": "device-events", "kind": "builtin", "root": "device-events", "host": "host/index.mjs", "background": ["watcher"] },
    { "id": "system-levels", "kind": "builtin", "root": "system-levels", "host": "host/index.mjs", "background": ["watcher"] },
    { "id": "device-use", "kind": "builtin", "root": "device-use", "host": "host/index.mjs", "background": [] },
    { "id": "theme-market", "kind": "builtin", "root": "theme-market", "host": "host/index.mjs", "background": [] },
    { "id": "updater", "kind": "essential", "root": "updater", "host": "host/index.mjs", "background": [], "provides": ["market/v1"] }
  ]
}
