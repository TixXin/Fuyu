{
  "name": "@someone/fuyu-weather",
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "repository": "github:someone/fuyu-weather",
  "engines": { "fuyu": ">=0.4.0" },
  "dependencies": {
    "tiny-format": "^1.2.0"
  },
  "fuyu": {
    "manifest": 1,
    "displayName": { "zh-CN": "天气", "en": "Weather" },
