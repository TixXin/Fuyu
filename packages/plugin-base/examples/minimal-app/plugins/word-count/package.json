{
  "name": "@demo/word-count",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "repository": "github:demo/word-count",
  "engines": {
    "fuyu": ">=0.1.0"
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "字数统计",
      "en": "Word Count"
    },
    "description": {
      "zh-CN": "统计笔记条数与总词数",
      "en": "Counts notes and words across notes"
    },
    "icon": "icon.svg",
    "categories": [
      "utilities"
    ],
    "host": "host.mjs",
    "client": {
      "main": "window.mjs"
    },
    "inject": {
      "required": [
        "notes/v1"
      ]
    },
    "slots": [
      "main.panel/v1"
    ]
  }
}
