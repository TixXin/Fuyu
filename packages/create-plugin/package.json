{
  "name": "@fuyu/create-plugin",
  "version": "2.0.0",
  "private": true,
  "description": "Plugin platform v3: creates a Fuyu plugin project in TypeScript (published later as create-fuyu-plugin 2.0)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-fuyu-plugin": "bin/create-fuyu-plugin.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["bin", "src", "template", "README.md"],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@fuyu/plugin-manifest": "workspace:*"
  },
  "devDependencies": {
    "@fuyu/plugin-base": "workspace:*",
    "@fuyu/plugin-cli": "workspace:*",
    "@fuyu/plugin-services": "workspace:*",
    "@types/react": "^19.1.8",
    "eslint": "^10.14.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1"
  }
}
