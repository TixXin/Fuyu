    "prune:target": "node scripts/prune-build-cache.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "release": "node scripts/release/release.mjs",
    "release:version": "node scripts/release/bump.mjs",
    "release:prebuild": "node scripts/release/prebuild.mjs",
    "plugins:index": "node scripts/plugins/build-plugin-index.mjs",
    "plugins:keygen": "node scripts/plugins/plugin-signing.mjs keygen",
    "sdk:build": "node scripts/plugins/build-plugin-sdk.mjs",
