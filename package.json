  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.23.0",
