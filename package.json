    "test": "node --test \"tests/**/*.test.mjs\" \"packages/*/test/**/*.test.mjs\"",
    "check:size": "node scripts/check-file-size.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "check:tasks": "node scripts/tasks/tasks.mjs check",
    "tasks": "node scripts/tasks/tasks.mjs",
    "task:claim": "node scripts/tasks/tasks.mjs claim",
    "tasks:plugin": "node scripts/tasks/install-island-plugin.mjs",
    "verify": "node scripts/land-check.mjs",
    "test:regression": "node scripts/run-regression.mjs",
    "lab": "node scripts/island-lab/server.mjs",
    "settings:index": "node scripts/settings-search-index.mjs",
    "check:tests-types": "tsc -p tests/tsconfig.json",
    "lint": "eslint src",
    "check": "tsc && pnpm run check:tests-types && pnpm run check:packages-types && pnpm run lint && pnpm run check:size && pnpm run check:colors && pnpm run check:tasks && pnpm run test",
    "check:packages-types": "tsc -p packages/tsconfig.json",
    "readme:assets": "node scripts/readme/assets.mjs",
    "mq:land": "node scripts/mq/mq.mjs land",
    "mq:wait": "node scripts/mq/mq.mjs wait",
    "mq:sync": "node scripts/mq/mq.mjs sync",
    "mq:pending": "node scripts/mq/mq.mjs pending"
